generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidat {
  id       String @id @default(cuid())
  nom      String
  postnom  String
  prenom   String
  faculte  String
  votes    Int    @default(0)
  slogan   String
  access   String
}